# ─── item+ Default Configuration ───
# This file is used as the shared first-start template for both backends.
# item+ creates a local .env from this file when none exists yet.

# Remove the next line after reviewing your local .env.
ITEMPLUS_SETUP_REQUIRED=remove_this_line_after_review

# ─── App ───
APP_NAME=item+
# APP_VERSION is optional. If omitted, item+ uses the shared VERSION file from the repo root.
APP_DOMAIN=
DEBUG=false
DEBUG_HTTP=false
ENABLE_API_DOCS=false

# ─── Database ───
DATABASE_URL=sqlite+aiosqlite:///./itemplus.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/itemplus
# MariaDB:    mysql+aiomysql://user:password@localhost:3306/itemplus

# ─── JWT ───
# Auto-generated on first run, stored in .jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=30

# ─── Apple Sign-In ───
# Required for iOS app login — get from Apple Developer Portal
APPLE_BUNDLE_ID=

# ─── CORS ───
# Production: set to your domain, e.g. ["https://itemplus.app"]
# Development: ["*"] (no credentials forwarding with wildcard)
CORS_ORIGINS=["*"]

# ─── Uploads ───
# Relative paths are resolved next to the .env file.
# Use an absolute path in production if you prefer, e.g. /var/lib/itemplus/uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=157286400

# ─── TSC Thermal Printer ───
PRINTER_HOST=
PRINTER_PORT=9100

# ─── SMTP (Magic Link) ───
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=item+
SMTP_USE_TLS=false
MAGIC_LINK_EXPIRY_MINUTES=15
MAGIC_LINK_BASE_URL=

# ─── Server ───
HOST=0.0.0.0
PORT=8000
