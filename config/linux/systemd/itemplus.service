[Unit]
Description=item+ server
Documentation=https://github.com/dncloud/itemplus
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=itemplus
Group=itemplus
WorkingDirectory=/var/lib/itemplus
StateDirectory=itemplus
StateDirectoryMode=0750
Environment=ITEMPLUS_DATA_DIR=/var/lib/itemplus/data
ExecStart=/usr/local/bin/itemplus-server --config /etc/itemplus/itemplus.conf
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/itemplus
UMask=0027
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
